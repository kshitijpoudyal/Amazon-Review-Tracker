# Auto-bumps the minor app version (src/utils/version.ts) whenever main is
# pushed, so a live prod deploy always shows a new number in the header menu.
#
# git determines what to push BEFORE this hook runs, so a commit made here
# can't ride along on the push already in flight. Instead: bump + commit,
# then abort this push and ask for a re-run — the retry picks up the bump
# commit as the new tip and goes through untouched.

is_main_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    is_main_push=1
  fi
done

if [ "$is_main_push" -ne 1 ]; then
  exit 0
fi

head_subject=$(git log -1 --format=%s)
case "$head_subject" in
  "chore: bump version to "*)
    # Already bumped on a previous (aborted) attempt for this push — proceed.
    exit 0
    ;;
esac

new_version=$(node scripts/bump-version.mjs)
if [ -z "$new_version" ]; then
  echo "pre-push: version bump failed, aborting push." >&2
  exit 1
fi

git add src/utils/version.ts
git commit --no-verify -m "chore: bump version to $new_version" >/dev/null

echo ""
echo "Bumped app version to $new_version (src/utils/version.ts) and committed it."
echo "Run 'git push' again to include it."
echo ""
exit 1
